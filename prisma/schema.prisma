generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Supplier {
  id String @id @default(uuid())
  name String
  products Product[]
}
model Product {
  id String @id @default(uuid())
  sku String @unique
  name String
  category String
  brand String
  fabric String
  pieces Int
  cost Decimal @db.Decimal(12,2)
  minimumPrice Decimal @db.Decimal(12,2)
  validated Boolean @default(false)
  supplierId String?
  supplier Supplier? @relation(fields:[supplierId],references:[id])
  variations Variation[]
  listings Listing[]
  performance Performance[]
  createdAt DateTime @default(now())
}
model Variation {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  size String
  color String
  stock Int
  @@unique([productId,size,color])
}
model Listing {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields:[productId],references:[id])
  channel String
  externalId String?
  price Decimal @db.Decimal(12,2)
  title String
  versions ListingVersion[]
}
model ListingVersion {
  id String @id @default(uuid())
  listingId String
  listing Listing @relation(fields:[listingId],references:[id])
  content Json
  createdAt DateTime @default(now())
}
model CompetitorSnapshot {
  id String @id @default(uuid())
  externalId String
  channel String
  source String
  capturedAt DateTime
  data Json
  @@unique([channel,externalId,capturedAt])
}
model Keyword {
  id String @id @default(uuid())
  term String
  source String
  volume Int?
  capturedAt DateTime @default(now())
}
model Performance {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields:[productId],references:[id])
  date DateTime @db.Date
  channel String
  historical Boolean
  orders Int
  visits Int?
  price Decimal? @db.Decimal(12,2)
  revenue Decimal @db.Decimal(12,2)
  adSpend Decimal @db.Decimal(12,2)
  cost Decimal @db.Decimal(12,2)
  @@unique([productId,date,channel,historical])
}
model Approval {
  id String @id @default(uuid())
  kind String
  productId String
  payload Json
  status String @default("PENDING")
  requestedBy String
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
}
model AgentRun {
  id String @id @default(uuid())
  agent String
  productId String
  channel String
  idempotencyKey String @unique
  status String @default("QUEUED")
  result Json?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Integration {
  id String @id
  encryptedTokens String?
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id String @id @default(uuid())
  actor String
  action String
  entityId String
  data Json
  createdAt DateTime @default(now())
}
model Setting {
  key String @id
  value Json
}
model ImportBatch {
  id String @id @default(uuid())
  digest String @unique
  rows Int
  createdAt DateTime @default(now())
}
